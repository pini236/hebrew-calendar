<?xml version="1.0" encoding="utf-8"?>
<!-- Sefirat HaOmer, 4×2: the day, its sefira and its count beside the 49 days; before nightfall the sky to the next count.
     The same page as the main widget (paper, a hairline edge, the silk ribbon's frames, Frank Ruhl Libre as bitmaps from
     WidgetDraw.date), the 7×7 field as three tinted masks (OmerWidgetDraw). OmerWidgetProvider sets the colours in code
     (values/widget_colors.xml and values-night, chosen by the app's colour scheme) and shows the parts of the state.
     Its HTML twin: src/components/seasons/OmerWidgetMock.tsx. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:clipToOutline="true"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/w_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_paper" />

    <ImageView
        android:id="@+id/w_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_edge" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_num"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="start"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/w_sef"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1" />
            <TextView
                android:id="@+id/w_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:includeFontPadding="false"
                android:textColor="@color/widget_muted"
                android:textSize="11sp"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="4" />
            <ImageView
                android:id="@+id/w_title"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_gravity="start"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <TextView
                android:id="@+id/w_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:includeFontPadding="false"
                android:textColor="@color/widget_muted"
                android:textSize="11sp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2" />
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <LinearLayout
                android:id="@+id/w_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/w_pre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_muted"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1" />
                <ImageView
                    android:id="@+id/w_bignum"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:adjustViewBounds="true"
                    android:baseline="31.2dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/w_post"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textColor="@color/widget_muted"
                    android:textSize="13sp"
                    android:layout_marginStart="6dp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_left"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">
