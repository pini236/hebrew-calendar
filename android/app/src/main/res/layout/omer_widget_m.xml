<?xml version="1.0" encoding="utf-8"?>
<!-- Sefirat HaOmer, 4×2 and up: the day and its sefira beside the 49 days.
     The same page as the main widget (paper, hairline edge, the silk ribbon's frames, the day in Frank Ruhl Libre as
     a bitmap) and the 7×7 field as three tinted masks (OmerWidgetDraw). OmerWidgetProvider sets the colours in code
     (values/widget_colors.xml and values-night) so light and dark never mix. Its HTML twin: OmerWidgetMock.tsx. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:clipToOutline="true"
    android:layoutDirection="rtl">

