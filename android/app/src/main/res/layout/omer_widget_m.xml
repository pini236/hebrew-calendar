                        android:id="@+id/w_ribbon"
                        android:layout_width="13.51dp"
                        android:layout_height="13.51dp"
                        android:layout_gravity="top|left"
                        android:autoStart="true"
                        android:flipInterval="91"
                        android:importantForAccessibility="no">
