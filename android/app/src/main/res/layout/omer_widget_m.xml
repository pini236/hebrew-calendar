    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="bottom|start"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_num"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:scaleType="fitEnd" />
            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="start"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_date"
                android:textSize="20sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/w_sef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/w_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="start"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/w_field"
            android:layout_width="118dp"
            android:layout_height="118dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="14dp">
            <ImageView
                android:id="@+id/w_f_muted"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/w_f_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/w_f_ribbon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:visibility="gone" />
