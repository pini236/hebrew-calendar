<?xml version="1.0" encoding="utf-8"?>
<!-- Standard size (4×2 and up to 4×3): the next zman beside the coming Shabbat or Yom Tov.
     Same page in every size: paper, a hairline edge, the ribbon, the Hebrew date drawn in Frank Ruhl Libre
     (a bitmap, WidgetDraw), everything else in the phone's own sans. Colours: values/widget_colors.xml
     and values-night; LuachWidgetProvider sets them again in code so light and dark never mix. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:clipToOutline="true"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/w_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_paper" />

    <ImageView
        android:id="@+id/w_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_edge" />

    <ImageView
        android:id="@+id/w_ribbon"
        android:layout_width="10dp"
        android:layout_height="18dp"
        android:layout_gravity="top|right"
        android:layout_marginRight="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ribbon" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">
        <ImageView
            android:id="@+id/w_date"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:scaleType="fitEnd" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:baselineAligned="true">
            <TextView
                android:id="@+id/w_greg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/w_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
            <TextView
                android:id="@+id/w_side_em"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:layout_marginStart="8dp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <ImageView
            android:id="@+id/w_sky"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/w_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/w_next_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/w_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:textColor="@color/widget_ink"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:layout_marginTop="1dp" />
                <Chronometer
                    android:id="@+id/w_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/widget_ribbon_ink"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageView
                android:id="@+id/w_vrule"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@color/widget_line"
                android:importantForAccessibility="no" />
            <LinearLayout
                android:id="@+id/w_holy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/w_holy_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/w_candle"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_candle"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/w_in_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:textColor="@color/widget_muted"
                        android:textSize="12sp"
                        android:text="@string/widget_in" />
                    <TextView
                        android:id="@+id/w_in_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:textColor="@color/widget_ink"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/w_out_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:textColor="@color/widget_muted"
                        android:textSize="12sp"
                        android:text="@string/widget_out" />
                    <TextView
                        android:id="@+id/w_out_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:textColor="@color/widget_ink"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:fontFeatureSettings="tnum" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
