<?xml version="1.0" encoding="utf-8"?>
<!-- Wide and low (4×2 on launchers with small cells): one line for the next zman, one for Shabbat.
     Same page in every size: paper, a hairline edge, the ribbon, the Hebrew date drawn in Frank Ruhl Libre
     (a bitmap, WidgetDraw), everything else in the phone's own sans. Colours: values/widget_colors.xml
     and values-night; LuachWidgetProvider sets them again in code so light and dark never mix. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:clipToOutline="true"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/w_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_paper" />

    <ImageView
        android:id="@+id/w_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_edge" />

    <ImageView
        android:id="@+id/w_ribbon"
        android:layout_width="10dp"
        android:layout_height="18dp"
        android:layout_gravity="top|right"
        android:layout_marginRight="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ribbon" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">
        <ImageView
            android:id="@+id/w_date"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:scaleType="fitEnd" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/w_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/w_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <Chronometer
                android:id="@+id/w_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/widget_ribbon_ink"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_holy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/w_holy_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
            <ImageView
                android:id="@+id/w_candle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_candle"
                android:visibility="gone" />
            <TextView
                android:id="@+id/w_in_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:text="@string/widget_in"
                android:layout_marginStart="4dp" />
            <TextView
                android:id="@+id/w_in_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:layout_marginStart="4dp" />
            <TextView
                android:id="@+id/w_out_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:text="@string/widget_out"
                android:layout_marginStart="10dp" />
            <TextView
                android:id="@+id/w_out_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
