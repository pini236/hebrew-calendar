<!-- Smallest size (2×1½ and below on launchers with small cells): the date and the next zman.
     Same page in every size: paper, a hairline edge, the ribbon, the Hebrew date drawn in Frank Ruhl Libre
     (a bitmap, WidgetDraw), everything else in the phone's own sans. Colours: values/widget_colors.xml
     and values-night; LuachWidgetProvider sets them again in code so light and dark never mix. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_paper"
    android:clipToOutline="true"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/w_paper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_paper" />

    <ImageView
        android:id="@+id/w_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_edge" />

